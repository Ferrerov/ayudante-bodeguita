// Ayudante Bodeguita - Prisma Schema
// Modelo de datos del MVP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                 Int      @id @default(autoincrement())
  sku                String   @unique
  type               String   // Producto, Combo, Servicio
  parentSku          String?  @map("parent_sku")
  name               String
  attribute1         String?
  attribute1Variant  String?  @map("attribute1_variant")
  attribute2         String?
  attribute2Variant  String?  @map("attribute2_variant")
  barcode            String?
  oemCode            String?  @map("oem_code")
  description        String?
  status             String   // Activo, Inactivo
  currency           String?
  internalCost       Decimal  @default(0) @map("internal_cost") @db.Decimal(12, 2)
  basePrice          Decimal  @default(0) @map("base_price") @db.Decimal(12, 2)
  vat                Decimal  @default(0) @db.Decimal(5, 2)
  finalPrice         Decimal  @default(0) @map("final_price") @db.Decimal(12, 2)
  profitability      Decimal  @default(0) @db.Decimal(8, 2)
  stock              Decimal  @default(0) @db.Decimal(12, 2)
  reservedStock      Decimal  @default(0) @map("reserved_stock") @db.Decimal(12, 2)
  availableStock     Decimal  @default(0) @map("available_stock") @db.Decimal(12, 2)
  minimumStock       Decimal  @default(0) @map("minimum_stock") @db.Decimal(12, 2)
  visibleInSales     Boolean  @default(true) @map("visible_in_sales")
  category           String?
  subcategory        String?
  supplier           String?
  notes              String?
  purchaseAccount    String?  @map("purchase_account")
  salesAccount       String?  @map("sales_account")
  inventoryAccount   String?  @map("inventory_account")
  replenishmentItem  ReplenishmentItem?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("products")
}

model ReplenishmentItem {
  id            Int       @id @default(autoincrement())
  sku           String    @unique
  product       Product   @relation(fields: [sku], references: [sku], onDelete: Cascade)
  name          String
  quantity      Decimal   @default(0) @db.Decimal(12, 2)
  status        String    @default("PENDING")
  replenishedAt DateTime? @map("replenished_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([name])
  @@map("replenishment_items")
}

model ImportJob {
  id            Int                      @id @default(autoincrement())
  type          String
  status        String
  filename      String
  checksum      String?
  rowsRead      Int                      @default(0) @map("rows_read")
  rowsImported  Int                      @default(0) @map("rows_imported")
  warnings      Json?
  errors        Json?
  metadata      Json?
  undoOfJobId   Int?                     @map("undo_of_job_id")
  undoneAt      DateTime?                @map("undone_at")
  startedAt     DateTime                 @default(now()) @map("started_at")
  finishedAt    DateTime?                @map("finished_at")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  snapshots     ImportSnapshot[]
  movements     ReplenishmentMovement[]

  @@index([type, createdAt])
  @@index([status, createdAt])
  @@map("import_jobs")
}

model ImportSnapshot {
  id         Int       @id @default(autoincrement())
  jobId      Int       @map("job_id")
  job        ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  domainType String    @map("domain_type")
  scopeKey   String?   @map("scope_key")
  data       Json
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([jobId])
  @@index([domainType, scopeKey])
  @@map("import_snapshots")
}

model ReplenishmentMovement {
  id          Int       @id @default(autoincrement())
  jobId       Int       @map("job_id")
  job         ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sku         String
  delta       Decimal   @db.Decimal(12, 2)
  beforeQty   Decimal   @map("before_qty") @db.Decimal(12, 2)
  afterQty    Decimal   @map("after_qty") @db.Decimal(12, 2)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([jobId, sku])
  @@map("replenishment_movements")
}

model PriceList {
  id        Int             @id @default(autoincrement())
  code      String          @unique
  name      String
  items     PriceListItem[]
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@map("price_lists")
}

model PriceListItem {
  id          Int       @id @default(autoincrement())
  priceListId Int       @map("price_list_id")
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  sku         String
  name        String
  category    String?
  subcategory String?
  description String?
  basePrice   Decimal   @default(0) @map("base_price") @db.Decimal(12, 2)
  vat         Decimal   @default(0) @db.Decimal(5, 2)
  finalPrice  Decimal   @default(0) @map("final_price") @db.Decimal(12, 2)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([priceListId, sku])
  @@index([sku])
  @@map("price_list_items")
}
